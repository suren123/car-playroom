{
  "name": "car-playroom",
  "version": "0.2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/suren123/car-playroom.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/generate-game-resources.mjs && node scripts/run-framework.mjs dev",
    "build": "node scripts/generate-game-resources.mjs && node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs scripts/preview.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:rules": "node scripts/test-games.mjs && node scripts/test-replay.mjs && node scripts/test-sudoku.mjs && node scripts/test-sudoku-feedback.mjs && node scripts/test-difference.mjs && node scripts/test-road.mjs && node scripts/test-delivery.mjs && node scripts/test-delivery-speech.mjs && node scripts/test-delivery-feedback.mjs && node scripts/test-workshop.mjs",
    "check:assets": "node scripts/generate-game-resources.mjs --check && node scripts/validate-assets.mjs",
    "test:records": "node scripts/test-records-memory.mjs",
    "test:navigation": "node scripts/test-game-navigation.mjs",
    "test:rounds": "node scripts/test-round-lifecycle.mjs",
    "assets:export": "py scripts/export-illustrations.py",
    "resources:generate": "node scripts/generate-game-resources.mjs",
    "test:resources": "node scripts/test-resources.mjs",
    "test:workshop": "node scripts/test-workshop.mjs",
    "test:expansion": "node scripts/test-expansion.mjs",
    "assets:expansion": "python scripts/export-expansion-art.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
